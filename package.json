{
  "name": "hindsight-memory",
  "displayName": "Hindsight Memory",
  "description": "Hindsight memory plugin for OpenClaw - biomimetic long-term memory with fact extraction",
  "version": "2026.10.9",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-hindsight-memory#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ani6439walc/openclaw-plugin-hindsight-memory.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-hindsight-memory/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "hindsight-memory"
  ],
  "files": [
    "README.md",
    "package.json",
    "openclaw.plugin.json",
    "dist"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9",
      "minGatewayVersion": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc",
    "prepack": "node scripts/pack-manifest.mjs strip",
    "postpack": "node scripts/pack-manifest.mjs restore",
    "backfill:help": "node dist/backfill.js --help"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@vectorize-io/hindsight-agent-sdk": "0.1.1",
    "@vectorize-io/hindsight-all": "1.1.0",
    "@vectorize-io/hindsight-client": "1.1.0"
  },
  "peerDependencies": {
    "openclaw": "2026.10.9"
  },
  "devDependencies": {
    "@openclaw/proxyline": "0.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "prettier": "3.9.10"
  }
}
